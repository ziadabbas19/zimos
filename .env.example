# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
API_VERSION=v1

# PostgreSQL
# On a host like Railway/Heroku, set DATABASE_URL to the single connection
# string and the DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD lines below are
# ignored (except under NODE_ENV=test, which always uses DB_NAME_TEST).
# DATABASE_URL=postgresql://user:password@host:port/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zimos_dev
DB_NAME_TEST=zimos_test
DB_USER=postgres
# Required unless DATABASE_URL carries a password. There is no default, under
# NODE_ENV=test too (it is the local database's own password).
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0

# JWT
# Required in every environment: the app has no fallback for it and refuses
# to start without it (in production, also when it is shorter than 32
# characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value. The test suite sets its own test-only value
# (tests/helpers/testEnv.js) and ignores this one.
JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET is no longer read: refresh tokens are random strings
# stored hashed. A deployment that still sets it is unaffected.
JWT_ACCESS_EXPIRES_IN=15m
# How long a device stays signed in, in days, counted from its last refresh
# (every refresh starts the count again). SESSION_TTL_DAYS is for everyone;
# SESSION_TTL_DAYS_CONSOLE is for an account with a platform role (the
# console's users), in the dashboard too. A whole number from 1 to 365; unset
# or anything else = 30. A new value reaches a session at its next refresh.
# JWT_REFRESH_EXPIRES_IN was never read and is gone.
SESSION_TTL_DAYS=
SESSION_TTL_DAYS_CONSOLE=
# "true": only a refresh token that was rotated away counts as replayed and
# ends every session of the account; one whose session was ended on purpose
# (signed out, a password reset) is refused alone. Unset = both end every
# session, as before.
REFRESH_REUSE_ROTATED_ONLY=
# "true": turning two-step sign-in on or off ends the account's other
# sessions and keeps the device that did it. Unset = sessions are left alone.
TWO_FACTOR_CHANGE_ENDS_SESSIONS=

# CORS
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
# "true" with REDIS_URL set: rate-limit counters shared through Redis (needs the
# rate-limit-redis and ioredis packages). Unset = counted in memory, as before.
RATE_LIMIT_REDIS=
REDIS_URL=
# Sign-in, sign-up, password reset and resend-verification per IP alone, on
# top of AUTH_RATE_LIMIT_MAX (whose key includes the email sent, so a new email
# got a new allowance). Sign-in counts failed attempts only. Everyone behind one
# IP (an office, a mobile carrier) shares it. Defaults: 50 per 15 minutes.
AUTH_IP_RATE_LIMIT_MAX=50
AUTH_IP_RATE_LIMIT_WINDOW_MS=900000
# The 6-digit sign-up and confirmation codes, per IP, counted in the database
# over every code sent from that IP (sign-up, sign-in while unconfirmed, the
# resend button, confirming a signed-in account's email). Everyone behind one
# IP shares them. Unset = these defaults; anything but a whole number of 1 or
# more refuses to start. The limits per address and per account stay fixed.
VERIFICATION_CODES_PER_IP_PER_HOUR=20
VERIFICATION_CODES_PER_IP_PER_DAY=50
VERIFICATION_SMS_PER_IP_PER_DAY=5
# Checkout phone codes one client (an IPv6 /56) may have sent across every
# store, per minute and per hour (risk/checkoutOtp). Unset or 0 is off.
CHECKOUT_OTP_IP_PER_MINUTE=
CHECKOUT_OTP_IP_PER_HOUR=
# Two-step sign-in (email / WhatsApp / authenticator codes, backup codes,
# remembered browsers, the console's reset). "true" turns it on; unset = off.
TWO_FACTOR_ENABLED=
# "true": a password sign-in from a browser new to the account is asked for
# an email code. Unset = off.
NEW_DEVICE_CODE=
# "true": an email when a sign-in finishes on a browser new to the account.
# Unset = off.
NEW_DEVICE_ALERT=
# "true": a checkout, shipping quote or coupon preview naming a funnel must
# name a published funnel of this store that sells those items. Unset = off.
FUNNEL_CHECKOUT_GUARD=
# Store features ported from the extended build, comma separated; unset = all off.
# Names: size_charts, product_questions, stock_alerts, preorders, holiday_mode,
# url_redirects, product_specs, purchase_limits, gift_options, gift_cards, blog,
# order_messages, webhook_headers, email_blocks, shopper_accounts, store_credit,
# vip_tiers, loyalty, customer_referrals, shopper_returns, return_exchanges,
# tracking_provider, rfm, store_reports, scheduled_reports, extra_pixels.
STORE_FEATURES=
# Tracking providers for manual waybills (shipping/trackingProviders), with tracking_provider on.
# AfterShip key and base (the key never logged); the sandbox in production only with TRACKING_SANDBOX;
# how often and how far back the job reads (defaults 60 min, 45 days, 50 per store, 500 per run).
AFTERSHIP_API_KEY=
AFTERSHIP_API_BASE=
TRACKING_SANDBOX=
TRACKING_SANDBOX_LATE_SECONDS=
TRACKING_POLL_INTERVAL_MINUTES=
TRACKING_POLL_MAX_AGE_DAYS=
TRACKING_POLL_PER_STORE=
TRACKING_POLL_BATCH=
# Server events of the extra pixels (extra_pixels): sandbox (built and logged, never sent)
# unless set to live, each after checking a real account.
PINTEREST_CAPI_MODE=
REDDIT_CAPI_MODE=
MICROSOFT_CAPI_MODE=
X_CAPI_MODE=
# Email and SMS delivery status and the email suppression list (notifications/deliveryStatus).
# "true" turns them on; unset = off. With it: the Brevo webhook secret, this API's public origin
# for Twilio status callbacks, the console provider's simulated reports (not in production),
# and the per-provider webhook rate limit (default 3000 a minute).
DELIVERY_STATUS_ENABLED=
BREVO_WEBHOOK_TOKEN=
NOTIFICATIONS_WEBHOOK_BASE_URL=
NOTIFICATION_STATUS_SIMULATION=
DELIVERY_WEBHOOK_RATE_LIMIT_MAX=
# Public endpoints kept closed until their identity checks are stronger; only
# the exact value true opens them. REVIEWS_PUBLIC_SUBMISSION_ENABLED: shoppers
# submitting product reviews (closed = 404 for every request; reading,
# moderation and ratings are unaffected). PASSWORD_RESET_SMS_ENABLED: password
# reset by SMS code (closed = the same answer for any number, nothing sent).
REVIEWS_PUBLIC_SUBMISSION_ENABLED=false
PASSWORD_RESET_SMS_ENABLED=false
# Changing an account's phone number from the dashboard by an SMS code to the
# new number. Only the exact value true opens it; closed, every request gets
# the same answer and nothing is sent. Needs real SMS (SMS_PROVIDER=twilio and
# its keys) in production; the console provider is refused there.
PHONE_CHANGE_ENABLED=false
# The platform's public details edited in the console's "Platform settings"
# (contact, social links, company, footer, the system emails' sender name and
# signature). Only the exact value true opens GET /api/v1/platform-settings/public
# and makes the emails use them; off, that endpoint answers 404 and the sites
# and emails show the values in their code. The console can edit either way.
PLATFORM_SETTINGS_ENABLED=false
# Public storefront API (/api/v1/store/*): each shopper gets RATE_LIMIT_MAX;
# these cap everything arriving from one connecting IP.
STOREFRONT_IP_RATE_LIMIT_MAX=500
STOREFRONT_SERVER_RATE_LIMIT_MAX=5000
# Public order tracking (GET /api/v1/store/:id/orders/track), keyed on the
# shopper's phone rather than their IP. _MAX is per phone + order number (one
# lookup being retried); _PHONE_MAX caps how many different order numbers can
# be tried against one phone, which is what actually bounds enumeration.
TRACKING_RATE_LIMIT_WINDOW_MS=600000
TRACKING_RATE_LIMIT_MAX=3
TRACKING_PHONE_RATE_LIMIT_MAX=30
# Same value as STOREFRONT_PROXY_SECRET in the storefront app. Lets its server
# pass each shopper's IP along; without it every server-rendered page view is
# counted against the storefront server's own IP. At least 32 characters:
#   openssl rand -hex 32
STOREFRONT_PROXY_SECRET=
# Optional, comma-separated IPs/CIDRs of the storefront server's outbound
# address. Only raises that IP's ceiling to STOREFRONT_SERVER_RATE_LIMIT_MAX —
# leave empty unless the address is static and not shared with other tenants.
STOREFRONT_SERVER_IP=

# The client IP behind Cloudflare (src/core/middleware/clientIp.js). Off by
# default: the client IP is req.ip, from X-Forwarded-For with trust proxy 1.
# CLIENT_IP_DEBUG=true logs, per request, X-Forwarded-For, CF-Connecting-IP,
# X-Real-IP and req.ip, and whether the edge secret matched (never its value).
CLIENT_IP_DEBUG=false
# TRUST_EDGE_CLIENT_IP=true takes CF-Connecting-IP as the client IP, but only
# on a request carrying EDGE_SECRET_HEADER with the value EDGE_SECRET (a
# Cloudflare Transform Rule adds it); anything else keeps req.ip. With it on,
# the app refuses to start without an "x-" header name or with a secret under
# 32 characters:
#   openssl rand -hex 32
TRUST_EDGE_CLIENT_IP=false
EDGE_SECRET_HEADER=
EDGE_SECRET=

# Platform domain (for subdomain-based tenant websites)
PLATFORM_ROOT_DOMAIN=zimos.test

# Notifications providers (mock by default; set to "console" | "smtp" | "twilio" etc.)
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# SMTP (only used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Uploaded-image storage: "local" (default, writes to public/uploads) or "r2"
# (Cloudflare R2 bucket — needed in production, the local disk is wiped on
# every redeploy). The R2_* vars are only required when STORAGE_PROVIDER=r2.
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: a second bucket with NO public access, for the files that are never
# linked publicly (shoppers' photos, payment proofs, digital products, order
# exports). Unset, or set to the bucket above, they are kept in R2_BUCKET_NAME,
# which is public. The boot log line "Storage backend:" says which is in effect.
R2_PRIVATE_BUCKET_NAME=
# The bucket's PUBLIC address with https:// (its r2.dev URL or custom domain),
# never the <account>.r2.cloudflarestorage.com API endpoint.
R2_PUBLIC_URL=
# Production on STORAGE_PROVIDER=local logs an error at every boot unless this
# says public/uploads is a persistent volume.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
# Library images are scaled down to this many pixels on their long side and
# re-encoded at this JPEG/WebP quality. 512px or smaller (icons) are untouched.
MEDIA_MAX_DIMENSION=2000
MEDIA_JPEG_QUALITY=85

# No longer read by the app (manual payments pick their provider from the
# order's payment method). Kept so existing deployments that set it are unaffected.
PAYMENTS_DEFAULT_PROVIDER=mock

# Online payments through the merchant's own gateway account (Paymob, Kashier).
# Off by default: the storefront stays cash on delivery only.
PAYMENTS_ONLINE_ENABLED=false
# 32 bytes, base64 (`openssl rand -base64 32`). Unset: gateway features answer 503.
GATEWAY_CREDENTIALS_KEY=
PAYMENT_ATTEMPT_TTL_MINUTES=30
PAYMENT_MAX_ATTEMPTS_PER_ORDER=5
PAYMENT_WEBHOOK_RATE_LIMIT_MAX=300
# Failed callbacks (4xx/5xx) one IP may send per RATE_LIMIT_WINDOW_MS, whatever
# webhook tokens it names; past it that IP is refused until the window ends.
# Unset or 0 is off. A gateway's servers are shared by every merchant on it:
# retries against one disconnected account count for all of them.
PAYMENT_WEBHOOK_FAILURES_PER_IP=
# Extra hosts a shopper may be sent back to after paying (comma-separated).
PAYMENT_RETURN_HOSTS=
PAYMOB_BASE_URL=https://accept.paymob.com
# Kashier API / checkout hosts per mode (defaults shown).
KASHIER_TEST_API_URL=https://test-api.kashier.io
KASHIER_LIVE_API_URL=https://api.kashier.io
KASHIER_TEST_FEP_URL=https://test-fep.kashier.io
KASHIER_LIVE_FEP_URL=https://fep.kashier.io

# Webhooks
WEBHOOK_SIGNING_ALGO=sha256

# Shared secret the billing gateway signs its webhook bodies with (HMAC-SHA256
# over the raw body, hex, sent as X-Zimos-Signature). REQUIRED for
# POST /api/v1/billing/webhook to accept anything: with this empty every
# webhook is rejected, so an unconfigured deploy can never have its
# subscriptions flipped by an unsigned request. Generate with
# `openssl rand -hex 32` and set the same value on the gateway.
BILLING_WEBHOOK_SECRET=

# Paying a subscription charge online through Fawaterak (Zimos's own account,
# not a store's). ONLINE_BILLING_ENABLED=true lets merchants start a payment;
# anything else leaves it off, and recording a payment by hand works either
# way. Webhooks settle payments already started whenever the keys are set.
# FAWATERAK_ENV: staging | live (default staging). FAWATERAK_BASE_URL and
# FAWATERAK_TOKEN_URL are optional overrides (https; the token URL must be on
# the base URL's origin). Client ID / secret: Fawaterak dashboard →
# Integrations → OAuth client credentials. FAWATERAK_HASH_KEY: the dashboard's
# "HASH API key", which signs Fawaterak's webhooks. FAWATERAK_WEBHOOK_TOKEN:
# ours, at least 32 characters (`openssl rand -hex 32`), part of the webhook
# URLs given to Fawaterak. Never commit values; set them on the host.
ONLINE_BILLING_ENABLED=
FAWATERAK_ENV=staging
FAWATERAK_BASE_URL=
FAWATERAK_TOKEN_URL=
FAWATERAK_CLIENT_ID=
FAWATERAK_CLIENT_SECRET=
FAWATERAK_HASH_KEY=
FAWATERAK_WEBHOOK_TOKEN=

# The prepaid balance and the pay-per-order plan (docs/billing-wallet.md).
# Only the exact value true turns it on; anything else is off: no order fee,
# no plan with a fee offered, no top-up — as before it existed. Its limits
# (top-up minimum and maximum, overdraft, open top-ups) are constants in
# src/modules/billing/walletService.js, not variables. Keep it off until the
# terms and refund policy for prepaid money are settled.
WALLET_ENABLED=

# A merchant changing plan by themselves from the Plans tab
# (src/modules/billing/planSwitchService.js). Only the exact value true turns
# it on; anything else is off and a paid subscription changes plan through
# support, as before. On: an upgrade costs the difference for the days left
# and starts once paid; a downgrade takes effect at the end of the paid
# period. A switch already made finishes either way. An upgrade's charge
# left unpaid PLAN_SWITCH_CHARGE_EXPIRY_HOURS (default 48, 1 to 720) is
# voided by the hourly billing job.
PLAN_SWITCH_ENABLED=
PLAN_SWITCH_CHARGE_EXPIRY_HOURS=

# Plan features as a gate. Only the exact value true turns it on; anything
# else is off and nothing is refused for a missing feature, as before. On:
# adding or verifying a custom domain needs custom_domain, inviting a team
# member needs staff_accounts and the web analytics need advanced_analytics,
# from the store's plan or a console override (403 PLAN_FEATURE_REQUIRED).
# No plan lists custom_domain today, so turning it on stops every store from
# connecting a domain unless the console grants it to that store.
PLAN_FEATURE_ENFORCEMENT=

# enforce | warn. What an unpaid subscription does one day after its period
# ends: `enforce` makes the storefront unavailable and blocks new products and
# funnels; `warn` only shows the dashboard banners. Defaults to warn in
# production, enforce elsewhere. Manual suspensions are enforced regardless.
BILLING_RESTRICTIONS=

# Google OAuth (get your own from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Twilio SMS (optional — leave SMS_PROVIDER=console to skip real sending)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Brevo Email (optional — leave EMAIL_PROVIDER=console to skip real sending)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Zimos
# Courier accounts merchants connect (Bosta today). Encrypts the credentials
# they paste in (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave empty to disable carrier integrations (connect / create shipment answer
# 503 CARRIERS_NOT_CONFIGURED; everything else works). Changing it makes every
# stored carrier credential unreadable — merchants would have to reconnect.
CARRIER_CREDENTIALS_KEY=
# Carrier status webhooks, per merchant webhook token per RATE_LIMIT_WINDOW_MS.
CARRIER_WEBHOOK_RATE_LIMIT_MAX=300
# Failed pushes (4xx/5xx) one IP may send per RATE_LIMIT_WINDOW_MS, whatever
# webhook tokens it names; past it that IP is refused until the window ends.
# Unset or 0 is off. A courier's servers are shared by every merchant on it:
# pushes to one disconnected account (404) count for all of them.
CARRIER_WEBHOOK_FAILURES_PER_IP=
# Which courier adapters exist on this server (comma-separated codes).
# CARRIERS_ENABLED: every store (unset = bosta; set but empty = none).
# CARRIERS_BETA: only the stores whose slugs are in CARRIERS_BETA_WORKSPACES;
# every other store behaves as if those couriers don't exist.
CARRIERS_ENABLED=bosta
CARRIERS_BETA=
CARRIERS_BETA_WORKSPACES=
# scripts/sync-carrier-shipments.js (Railway cron): shipments per batch, and
# how many days after booking a shipment is still polled.
CARRIER_SYNC_BATCH_SIZE=200
CARRIER_POLL_MAX_AGE_DAYS=45

# Storefront analytics: CDNs whose geo headers (country/region/city) the event
# ingest may trust, comma-separated: cloudflare, vercel, cloudfront. Leave
# empty unless this API really sits behind that CDN — otherwise any client can
# send the headers itself. Empty: visitor geo is not recorded.
ANALYTICS_GEO_HEADERS=
# Anonymous marketing-site visits for the console (POST /public/site-events,
# no IP and no cookie kept). Only the exact value true opens it; closed, the
# endpoint answers 404 and sign-up ignores siteSessionId. ORIGINS is that
# endpoint's own CORS list (comma-separated, e.g. https://zimos.co). Country
# comes from CF-IPCountry only when ANALYTICS_GEO_HEADERS includes cloudflare.
SITE_ANALYTICS_ENABLED=false
SITE_ANALYTICS_ORIGINS=

# COD confirmation queue: how long a claimed task stays locked to one agent
# before it returns to Pending on its own (minutes).
CONFIRMATION_LOCK_TTL_MINUTES=15

# Background work (core/queue, core/outbox): WORKER_IN_PROCESS=true runs the
# worker inside the API; otherwise run `node src/worker.js` as its own service.
# Off, events and jobs wait in the database until a worker starts.
WORKER_IN_PROCESS=false
QUEUE_POLL_MS=1000
QUEUE_CONCURRENCY=10
# true: the worker claims jobs, renews their locks and takes back stale ones on
# a database connection of its own (up to two, on top of DB_POOL_MAX), so jobs
# that hold the whole shared pool cannot stop their own locks being renewed.
# false (the default): those statements share the pool with the jobs, as before.
QUEUE_CONTROL_CONNECTION=false

# The demo seeder (npx sequelize-cli db:seed:all) creates a store owner whose
# password is public, and its undo empties whole tables. Under
# NODE_ENV=production it refuses to run unless this is "true". Leave it false;
# set it for one command, on a throwaway database only.
ALLOW_DEMO_SEED_IN_PRODUCTION=false

# true: a page or funnel-step element is refused when it carries a prop its
# type's rule set (src/modules/pages/pageTree.js) does not name. false (the
# default): such a prop is stored unchecked, as before. The rule sets do not
# list every prop the editor sends yet — complete them before turning this on,
# or pages the editor saves today are refused.
PAGE_TREE_STRICT_PROPS=false
# How long a running job's lock may go unrenewed before the job counts as cut
# off (ms; default 10 minutes). Running jobs renew it on a heartbeat.
QUEUE_STALE_LOCK_MS=
# Outbound webhooks to merchants' systems: WEBHOOKS_IN_PROCESS=true runs the
# sender inside the API; otherwise scripts/dispatch-webhooks.js from a cron.
WEBHOOKS_IN_PROCESS=false
WEBHOOKS_INTERVAL_MS=5000
WEBHOOKS_TIMEOUT_MS=10000
WEBHOOKS_BATCH_SIZE=50
# Private addresses (localhost, 10/8, …) as webhook targets: outside production only.
WEBHOOKS_ALLOW_PRIVATE_URLS=
# Seals merchants' integration secrets (WhatsApp, server pixels). No fallback:
# without it, connecting those integrations fails. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATIONS_ENCRYPTION_KEY=
# Checkout bot guard for stores that have not set it: on / off (default off).
BOT_PROTECTION_DEFAULT=off
# Providers with no adapter in this repo yet: empty = the feature answers
# "not configured".
CAPTCHA_PROVIDER=
TURNSTILE_SITE_KEY=
IP_INTEL_PROVIDER=
# cloudflare = Cloudflare for SaaS custom hostnames for merchant domains
# (modules/domains/certificates). The token needs Zone > SSL and
# Certificates: Edit on the platform zone only.
CERTIFICATE_PROVIDER=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Merchant custom domains: only the exact value true opens the dashboard
# routes under /workspaces/:id/domains (closed = 404 for each one). Domains
# already verified keep resolving through GET /store/resolve-host either way.
CUSTOM_DOMAINS_ENABLED=false
# The one host every merchant domain's CNAME points at (the Cloudflare for
# SaaS entry). Unset = customers.<PLATFORM_ROOT_DOMAIN>.
CUSTOM_DOMAIN_CNAME_TARGET=
# Domains one store may connect, verified or not. Unset = 1.
CUSTOM_DOMAINS_MAX_PER_STORE=
# The daily reconciliation queues for deletion custom hostnames at Cloudflare
# that no domain row knows; more than this many in one run queues none and
# logs a warning. Unset = 20.
CUSTOM_DOMAINS_RECONCILE_MAX=
# Public DNS servers asked for verification and the DNS check, comma
# separated. Unset = 1.1.1.1,8.8.8.8.
DOMAIN_VERIFY_RESOLVERS=
# Storefront read cache, seconds (0 = off).
STOREFRONT_CACHE_TTL_SECONDS=0
# The public API's own address, for its docs and links.
PUBLIC_API_URL=
# WhatsApp Cloud API (merchants' own numbers) and the platform's number for
# alerts (WHATSAPP_PROVIDER=cloud). Empty = not used.
META_GRAPH_API_VERSION=
WHATSAPP_GRAPH_BASE=
WHATSAPP_PLATFORM_PHONE_NUMBER_ID=
WHATSAPP_PLATFORM_TOKEN=
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_ALERT_LANG=
WHATSAPP_CODE_TEMPLATE=
WHATSAPP_CODE_LANG_AR=
WHATSAPP_CODE_LANG_EN=
# Refuse order status moves the stage table does not allow (409), on every path. Off: as before.
ORDER_STATUS_GUARDS=false
# AI features (modules/ai): product/page/policy drafts, AI translation of
# missing texts, the WhatsApp customer service bot and the AI check of
# moderate-risk orders. Only the exact value true turns them on; off, their
# routes answer 404, the bot never replies, nothing is queued and no provider
# is called. No real provider exists yet: AI_PROVIDER empty means the test
# sandbox outside production and none in production (AI_PROVIDER=sandbox runs
# the sandbox in production too, with a warning). Turn the API on before the
# dashboard's VITE_AI_ENABLED. AI_DAILY_LIMIT caps one store's AI requests per
# UTC day (jobs and bot replies together); empty means 50.
AI_ENABLED=false
AI_PROVIDER=
AI_DAILY_LIMIT=
