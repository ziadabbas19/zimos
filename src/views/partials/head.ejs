<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title %></title>
<style>
  /* Shared stylesheet for the built-in storefront viewer. */
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #1a1a1a;
    background: #f6f7f9;
    line-height: 1.5;
  }
  .wrap { max-width: 720px; margin: 0 auto; padding: 32px 20px 64px; }
  .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 24px; }
  h1 { font-size: 1.7rem; margin: 0 0 12px; }
  h2 { font-size: 1.2rem; margin: 24px 0 8px; }
  .price { font-size: 1.5rem; font-weight: 700; color: #0f766e; margin: 8px 0 16px; }
  .hero-img { width: 100%; max-height: 380px; object-fit: cover; border-radius: 10px; background: #eee; }
  ul.bullets { padding-left: 20px; margin: 12px 0; }
  ul.bullets li { margin: 4px 0; }
  .btn {
    display: inline-block; background: #0f766e; color: #fff; text-decoration: none;
    padding: 12px 22px; border-radius: 8px; font-size: 1rem; font-weight: 600; border: 0; cursor: pointer;
  }
  .btn:hover { background: #0b5c56; }
  label { display: block; font-weight: 600; margin: 14px 0 4px; font-size: 0.92rem; }
  input, textarea, select {
    width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; font-family: inherit;
  }
  textarea { min-height: 90px; }
  .muted { color: #6b7280; font-size: 0.9rem; }
  .ok { color: #0f766e; font-weight: 600; }
  .store-head { text-align: center; margin-bottom: 24px; }
  .store-head img.logo { max-height: 72px; max-width: 220px; object-fit: contain; margin-bottom: 8px; }
  .store-head .tagline { color: #6b7280; margin: 4px 0 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
  .product-card { display: block; text-decoration: none; color: inherit; background: #fff;
    border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
  .product-card img { width: 100%; height: 160px; object-fit: cover; background: #eee; display: block; }
  .product-card .body { padding: 12px 14px; }
  .product-card h3 { margin: 0 0 4px; font-size: 1rem; }
  .product-card .card-price { color: #0f766e; font-weight: 700; }
  .product-card .card-desc { color: #6b7280; font-size: 0.85rem; margin: 6px 0 0; }
  .wrap.wide { max-width: 960px; }
  table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #e5e7eb; }
  th { background: #f1f5f9; }
  code { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; word-break: break-all; }
</style>
